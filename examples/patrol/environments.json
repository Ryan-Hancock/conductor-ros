{
  "default": "sim",
  "environments": {
    "sim": {
      "transport": "inproc",
      "params": [
        "params.sim.yaml"
      ],
      "without": [
        "engage_estop"
      ]
    },
    "bench": {
      "transport": "inproc",
      "params": [
        "params.sim.yaml"
      ],
      "without": [
        "engage_estop"
      ],
      "deploy": {
        "scope": "user"
      },
      "dashboard_addr": "127.0.0.1:4000"
    },
    "robot": {
      "transport": "zenoh",
      "endpoint": "tcp/127.0.0.1:7447",
      "domain": 0,
      "params": [
        "params.robot.yaml"
      ],
      "metrics_addr": ":9090",
      "deploy": {
        "host": "pi@patrol-1",
        "goarch": "arm64",
        "tags": [
          "zenoh"
        ],
        "cgo": true,
        "cc": "aarch64-linux-gnu-gcc",
        "env": {
          "ROS_DOMAIN_ID": "0"
        }
      },
      "frames": "frames.robot.json",
      "dashboard_addr": ":4000",
      "robots": [
        {
          "name": "patrol-1",
          "host": "pi@patrol-1",
          "frames": "frames.robot.json"
        },
        {
          "name": "patrol-2",
          "host": "pi@patrol-2",
          "params": [
            "params.patrol-2.yaml"
          ],
          "dashboard_addr": ":4100",
          "metrics_addr": ":9190",
          "endpoint": "tcp/127.0.0.1:7448"
        }
      ]
    }
  }
}
