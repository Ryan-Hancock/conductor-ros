<?xml version="1.0"?>
<!--
  The patrol robot's description: the nominal geometry of a small differential
  drive base with a lidar and an IMU.

  frames.json is derived from this file, with -publish, because this robot has no
  robot_state_publisher: conductor is the only thing here that knows the
  geometry, so the runtime publishes these transforms on tf_static itself.

      conductor frames -from examples/patrol/patrol.urdf \
          -o examples/patrol/frames.json -publish

  The per-robot frames.robot.json stays hand-written: this file is the nominal
  robot, and a calibration is what a particular machine measured.
-->
<robot name="patrol">
  <link name="base_link"/>
  <link name="laser"/>
  <link name="imu"/>
  <link name="wheel_left"/>
  <link name="wheel_right"/>

  <!-- The lidar faces backwards, which is the sort of thing a launch file's
       positional arguments get wrong and a description does not. -->
  <joint name="laser_joint" type="fixed">
    <parent link="base_link"/>
    <child link="laser"/>
    <origin xyz="0.12 0 0.19" rpy="0 0 3.14159"/>
  </joint>

  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu"/>
    <origin xyz="0 0 0.05" rpy="0 0 0"/>
  </joint>

  <joint name="wheel_left_joint" type="continuous">
    <parent link="base_link"/>
    <child link="wheel_left"/>
    <origin xyz="0 0.16 0.033" rpy="-1.5708 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>

  <joint name="wheel_right_joint" type="continuous">
    <parent link="base_link"/>
    <child link="wheel_right"/>
    <origin xyz="0 -0.16 0.033" rpy="-1.5708 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>
</robot>
